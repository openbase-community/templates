{
  "name": "$${name_kebab}-workspace",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "auth:generate": "node ./auth-client/scripts/generate-auth-screens.mjs --target ./web",
    "auth:overwrite": "node ./auth-client/scripts/generate-auth-screens.mjs --target ./web --overwrite",
    "dev": "pnpm -r --parallel --stream --filter $${auth_client_package_name} --filter $${api_client_package_name} --filter $${ui_package_name} --filter $${web_package_name} run dev",
    "build": "pnpm --filter $${api_client_package_name} generate-client && pnpm --filter $${auth_client_package_name} build && pnpm --filter $${api_client_package_name} build && pnpm --filter $${ui_package_name} build && pnpm --filter $${web_package_name} build"
  }
}
